# =====================================================================
# Telegram Forward Bot - Configuration
# Copy this file to .env and fill in the values, OR set them as
# Environment Variables in your Railway dashboard.
# =====================================================================

# Bot token received from @BotFather on Telegram (REQUIRED)
# Example: BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
BOT_TOKEN=

# Comma-separated list of source chat IDs (channels or groups) (REQUIRED)
# You can use numeric IDs (e.g. -1001234567890) or public usernames (e.g. @channel_name)
# Example: SOURCE_CHAT_IDS=-1001234567890, -1009876543210, @my_channel
SOURCE_CHAT_IDS=

# Destination group ID or username where messages should be forwarded (REQUIRED)
# Example: TARGET_CHAT_ID=-1009999999999
TARGET_CHAT_ID=

# Send silently without sound notifications (true/false) - default: false
FORWARD_SILENT=false

# Logging level: DEBUG, INFO, WARNING, ERROR - default: INFO
LOG_LEVEL=INFO
